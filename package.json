{
  "name": "contabilium-picking",
  "version": "1.3.2",
  "description": "App web local de picking, control y etiquetado de ordenes de venta de Contabilium",
  "main": "server-standalone.js",
  "bin": "server-standalone.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server-standalone.js",
    "build": "pkg . --output dist/PickingContabilium.exe",
    "paquete": "npm run verificar && node pkg/armar-paquete.js",
    "verificar": "node pkg/verificar-exe.js"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  }
}
